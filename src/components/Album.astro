---
import Foto from './Foto.astro';
import fotos from '../data/fotos.json';
const hayFotosReales = fotos.album.some((f) => f.src);
---

<section id="album" class="rule-top">
  <div class="wrap">
    <div class="kicker">
      <h2>La casa <em>por dentro</em></h2>
      {
        !hayFotosReales && (
          <span class="marg" style="transform:rotate(-2deg)">
            pronto, fotos de verdad
          </span>
        )
      }
    </div>
    <div class="album">
      {
        fotos.album.map((f) => (
          <figure class="taped reveal">
            <Foto src={f.src} alt={f.caption} aspect="1" placeholder="foto" />
            <figcaption class="cap">{f.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
