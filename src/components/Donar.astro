---
import site from '../data/site.json';
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.donar;
---

<section id="donar" class="rule-top">
  <div class="wrap donar">
    <div class="reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 style="margin-top:10px" set:html={emify(t.titulo)} />
      <p class="lead">{t.lead}</p>
      <p class="marg">{t.agradecimiento}</p>
    </div>
    <div class="note-card reveal">
      <div class="alias-hero">
        <span class="alias-lbl">{t.aliasLabel}</span>
        <div class="alias-row">
          <b id="aliasVal">{site.alias}</b>
          <button class="copy" id="copyBtn">copiar</button>
        </div>
      </div>
      <div class="line"><span>Titular</span><b>{site.titular}</b></div>
      <div class="line"><span>CBU</span><b>{site.cbu}</b></div>
      <div class="line"><span>CUIT</span><b>{site.cuit}</b></div>
      <p class="tip" set:html={emify(t.tip)} />
      <div class="gr">{t.gracias}</div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copyBtn');
  const aliasEl = document.getElementById('aliasVal');
  btn?.addEventListener('click', () => {
    const alias = aliasEl?.textContent?.trim() ?? '';
    const done = () => {
      btn.textContent = '¡copiado!';
      btn.classList.add('ok');
      setTimeout(() => {
        btn.textContent = 'copiar';
        btn.classList.remove('ok');
      }, 1800);
    };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(alias).then(done).catch(done);
    } else {
      const t = document.createElement('textarea');
      t.value = alias;
      document.body.appendChild(t);
      t.select();
      try {
        document.execCommand('copy');
      } catch (e) {}
      document.body.removeChild(t);
      done();
    }
  });
</script>
