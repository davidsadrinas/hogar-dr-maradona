---
import tiers from '../data/tiers.json';
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.empresas;
// OJO: el cuadro fiscal (tags HOY / PRONTO) es contenido sensible.
// No cambiar la redacción sin pasar por el criterio fiscal acordado:
// auspicio deducible hoy como gasto de publicidad; donación deducible recién
// al obtener el certificado de ARCA (en trámite).
---

<section id="empresas" class="rule-top">
  <div class="wrap">
    <div class="emp-top">
      <div class="reveal">
        <span class="eyebrow">{t.eyebrow}</span>
        <h2
          class="serif"
          style="font-size:clamp(28px,3.8vw,42px);font-weight:400;margin-top:10px;letter-spacing:-.02em"
          set:html={emify(t.titulo)}
        />
        <p class="lead">{t.lead}</p>
      </div>
      <div class="fiscal reveal">
        {
          t.fiscal.map((f) => (
            <div class="frow">
              <span class:list={['ftag', f.tag === 'PRONTO' ? 'soon' : 'now']}>{f.tag}</span>
              <div>
                <b>{f.titulo}</b>
                <p>{f.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="tiers">
      {
        tiers.items.map((tier) => (
          <div class:list={['tier', 'reveal', { feat: tier.feat }]}>
            {tier.feat && <span class="fl stamp">{tier.destacado}</span>}
            <span class="n">{tier.nights}</span>
            <h3>{tier.nombre}</h3>
            <div class="amt">
              {tier.monto} {tier.periodo && <small>{tier.periodo}</small>}
            </div>
            <ul>
              {tier.beneficios.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <a href="#donar" class:list={['btn', tier.feat ? 'btn-sun' : 'btn-line']}>
              {tier.cta}
            </a>
          </div>
        ))
      }
    </div>
    <p class="emp-note reveal" set:html={emify(t.notaGrandes)} />
  </div>
</section>
