---
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.hacemos;
---

<section id="hacemos" class="rule-top">
  <div class="wrap">
    <div class="kicker">
      <h2 set:html={emify(t.titulo)} />
    </div>
    <div class="idx">
      {
        t.cards.map((c) => (
          <div class="icard reveal">
            <span class="tab">{c.tab}</span>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
            <div class="chk">{c.nota}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
