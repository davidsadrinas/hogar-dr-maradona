---
import Foto from './Foto.astro';
import fotos from '../data/fotos.json';
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.historia;
---

<section id="historia" class="rule-top">
  <div class="wrap">
    <div class="spread">
      <figure class="taped reveal">
        <Foto
          src={fotos.historia.src}
          alt={fotos.historia.caption}
          aspect="4/5"
          placeholder="foto de la historia (con permiso)"
        />
        <figcaption class="cap">{fotos.historia.caption}</figcaption>
      </figure>
      <div class="txt reveal">
        <span class="lbl">{t.etiqueta}</span>
        <h2 set:html={emify(t.titulo)} />
        {t.parrafos.map((p) => <p set:html={emify(p)} />)}
        <p class="ej">{t.aviso}</p>
      </div>
    </div>
  </div>
</section>
