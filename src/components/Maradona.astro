---
import Foto from './Foto.astro';
import fotos from '../data/fotos.json';
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.maradona;
---

<section id="maradona" class="rule-top">
  <div class="wrap">
    <div class="kicker">
      <span class="eyebrow">{t.eyebrow}</span>
      <span class="marg" style="transform:rotate(-2deg)">{t.notaMargen}</span>
    </div>
    <div class="spread spread-retrato">
      <div class="aside reveal">
        <figure class="taped" style="transform:rotate(-2deg)">
          <Foto
            src={fotos.maradona.src}
            alt={fotos.maradona.caption}
            aspect="4/5"
            placeholder="retrato del Dr. Maradona"
          />
          <figcaption class="cap">{fotos.maradona.caption}</figcaption>
        </figure>
      </div>
      <div class="body reveal">
        {t.parrafos.map((p) => <p set:html={emify(p)} />)}
        <p class="pull" style="border-color:var(--sun);font-size:22px">{t.cita}</p>
        <p set:html={emify(t.cierre)} />
      </div>
    </div>
  </div>
</section>
