---
import Foto from './Foto.astro';
import fotos from '../data/fotos.json';
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.nosotros;
---

<section id="nosotros" class="rule-top">
  <div class="wrap">
    <div class="kicker"><span class="eyebrow">{t.eyebrow}</span></div>
    <div class="cronica">
      <div class="body reveal">
        <h2 style="font-size:34px;margin-bottom:16px" set:html={emify(t.titulo)} />
        {t.parrafos.map((p) => <p set:html={emify(p)} />)}
        <p class="pull">{t.cita}</p>
        <div class="signoff">
          <div class="sig">{t.firma}</div>
          <div class="who">{t.cargo}</div>
        </div>
      </div>
      <div class="aside reveal">
        <figure class="taped">
          <Foto
            src={fotos.nosotros.src}
            alt={fotos.nosotros.caption}
            aspect="5/4"
            placeholder="una foto de la cocina, la mesa, el patio…"
          />
          <figcaption class="cap">{fotos.nosotros.caption}</figcaption>
        </figure>
        <p class="note">{t.notaManuscrita}</p>
      </div>
    </div>
  </div>
</section>
