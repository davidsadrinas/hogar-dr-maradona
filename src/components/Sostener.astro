---
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.sostener;
---

<section id="sostener" class="rule-top">
  <div class="wrap">
    <div class="kicker">
      <h2 set:html={emify(t.titulo)} />
    </div>
    <div class="sos-grid">
      <div class="reveal">
        <p class="sos-lead" set:html={emify(t.lead)} />
        <div class="sos-list">
          {
            t.items.map((item, i) => (
              <div class="li">
                <span class="n">{i + 1}</span>
                <p set:html={emify(item)} />
              </div>
            ))
          }
        </div>
      </div>
      <div class="sos-card reveal">
        <h3>{t.card.titulo}</h3>
        <div class="big">
          {t.card.monto}
          <span style="font-size:15px;color:#CFC4B2;font-family:'Inter'">{t.card.periodo}</span>
        </div>
        <p>{t.card.texto}</p>
        <a href="#donar" class="btn btn-sun">{t.card.boton}</a>
        <p class="marg hand">{t.card.notaManuscrita}</p>
      </div>
    </div>
  </div>
</section>
