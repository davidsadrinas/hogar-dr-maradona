---
import textos from '../data/textos.json';
import { emify } from '../lib/emify';
const t = textos.transparencia;
---

<section id="transparencia" class="rule-top">
  <div class="wrap">
    <div class="kicker"><h2 set:html={emify(t.titulo)} /></div>
    <div class="trust">
      {
        t.items.map((item) => (
          <div class="titem reveal">
            <b>{item.titulo}</b>
            <p>{item.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
